<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consulta de Deudores BCRA</title>
    <style>
        :root {
            --primary: #2563eb;
            --secondary: #64748b;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #1e293b;
        }
        body { 
            font-family: 'Segoe UI', system-ui, sans-serif; 
            background-color: var(--bg); 
            color: var(--text);
            margin: 0;
            display: flex;
            justify-content: center;
            padding: 40px 20px;
        }
        .container { 
            width: 100%;
            max-width: 800px; 
        }
        .card { 
            background: var(--card); 
            padding: 32px; 
            border-radius: 16px; 
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); 
        }
        h1 { 
            margin-top: 0;
            font-size: 24px;
            color: var(--primary);
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 16px;
        }
        .search-form { 
            margin: 24px 0;
            display: flex;
            gap: 12px;
        }
        input { 
            flex: 1;
            padding: 12px 16px; 
            border: 2px solid #e2e8f0; 
            border-radius: 8px; 
            font-size: 16px; 
            outline: none;
            transition: border-color 0.2s;
        }
        input:focus { border-color: var(--primary); }
        button { 
            padding: 12px 24px; 
            background: var(--primary); 
            color: white; 
            border: none; 
            border-radius: 8px; 
            cursor: pointer; 
            font-weight: 600;
            transition: opacity 0.2s;
        }
        button:hover { opacity: 0.9; }
        
        .info-box {
            background: #eff6ff;
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            border-left: 4px solid var(--primary);
        }
        .error { 
            background: #fef2f2; 
            color: #b91c1c; 
            padding: 16px; 
            border-radius: 8px; 
            margin-bottom: 24px;
            border-left: 4px solid #ef4444;
        }
        
        table { 
            width: 100%; 
            border-collapse: collapse; 
            margin-top: 8px;
        }
        th { 
            text-align: left; 
            background: #f1f5f9; 
            padding: 12px; 
            font-size: 14px;
            text-transform: uppercase;
            color: var(--secondary);
        }
        td { 
            padding: 16px 12px; 
            border-bottom: 1px solid #e2e8f0; 
        }
        .badge {
            padding: 4px 8px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: bold;
            background: #dcfce7;
            color: #166534;
        }
        .badge-warning { background: #fef9c3; color: #854d0e; }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h1>Sistema de Consulta BCRA</h1>

            <form class="search-form" action="/consultar" method="post">
                <input type="text" name="cuit" placeholder="Ingrese CUIT (ej: 20203848758)" required value="<%= @cuit %>">
                <button type="submit">Consultar</button>
            </form>

            <% if @error %>
                <div class="error">
                    <strong>Error:</strong> <%= @error %>
                </div>
            <% end %>

            <% if @nombre %>
                <div class="info-box">
                    <div style="font-size: 14px; color: var(--secondary);">Denominación / Nombre:</div>
                    <div style="font-size: 18px; font-weight: bold;"><%= @nombre %></div>
                    <% if @periodo_nombre %>
                        <div style="margin-top: 8px; font-size: 13px;">
                            Período informado: <strong><%= @periodo_nombre %></strong>
                        </div>
                    <% end %>
                </div>
            <% end %>

            <% if @deudas && @deudas.any? %>
                <table>
                    <thead>
                        <tr>
                            <th>Entidad Financiera</th>
                            <th>Estado</th>
                            <th>Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% @deudas.each do |deuda| %>
                            <tr>
                                <td style="font-weight: 500;"><%= deuda["entidad"] %></td>
                                <td>
                                    <span class="badge <%= 'badge-warning' if deuda["situacion"].to_i > 1 %>">
                                        Situación <%= deuda["situacion"] %>
                                    </span>
                                </td>
                                <td>$ <%= deuda["monto"].to_f.round(2) %></td>
                            </tr>
                        <% end %>
                    </tbody>
                </table>
            <% elsif @cuit && !@error %>
                <div style="text-align: center; color: var(--secondary); margin-top: 40px;">
                    No se registran deudas para el período actual.
                </div>
            <% end %>
        </div>
    </div>
</body>
</html>
